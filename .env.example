# fab_agent configuration — copy this file to `.env` and fill in values.
# Only LLM_API_KEY is typically required (except for the local Ollama backend).

# --- Model backend selection ---------------------------------------------

# Which LLM backend to use: gemini | openai | anthropic | ollama
# The architecture is model-agnostic; switching backends is a config change only.
LLM_PROVIDER=gemini

# Model identifier passed to the selected provider.
#   gemini    -> gemini-3.5-flash
#   openai    -> gpt-4o-mini
#   anthropic -> claude-sonnet-5
#   ollama    -> e.g. llama3.1:8b, qwen2.5:7b, mistral:7b
LLM_MODEL=gemini-3.5-flash

# API key for the selected provider. Leave blank for the local Ollama backend.
#
# Gemini (default, free tier): create a key at Google AI Studio
#   -> https://aistudio.google.com/app/apikey
# Gemini 3.5 Flash is the current free-tier model and needs no billing setup.
LLM_API_KEY=

# Optional base-URL override for OpenAI-compatible endpoints.
# Leave blank for hosted providers. For the `ollama` provider this defaults to
# http://localhost:11434/v1 automatically if left blank.
LLM_BASE_URL=

# --- Retrieval ------------------------------------------------------------

# sentence-transformers model used for dense (embedding) retrieval.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Adjudication ---------------------------------------------------------

# Rules Enforcement Level context applied to rulings.
# One of: casual | competitive | professional
REL_LEVEL=competitive
