# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
*.so

# --- Virtual environments -------------------------------------------------
.venv/
venv/
env/

# --- uv -------------------------------------------------------------------
# uv.lock is intentionally committed for reproducible installs.

# --- Environment / secrets ------------------------------------------------
.env
.env.*
!.env.example

# --- Tooling caches -------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# --- OS -------------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Data -----------------------------------------------------------------
# Raw source documents and built vector indexes are large / regenerable and
# are not tracked. Processed artifacts and the folder structure are kept.
data/raw/*
data/index/*
data/traces/*
!data/raw/.gitkeep
!data/index/.gitkeep
!data/traces/.gitkeep
